FROM node:22-bookworm-slim AS ui-builder

WORKDIR /ui

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY vite.config.ts tsconfig.json ./
COPY frontend ./frontend
RUN npm run build:ui \
    && test -f /ui/static/react/index.html

# Noble provides Python 3.12, required by the pinned NumPy dependency.
FROM mcr.microsoft.com/playwright/python:v1.52.0-noble AS runtime

ARG EPUBCHECK_VERSION=5.3.0

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    KINDLEMASTER_BIND_HOST=0.0.0.0 \
    KINDLEMASTER_EPUBCHECK_JAR=/opt/epubcheck/epubcheck.jar \
    KINDLEMASTER_UPLOAD_DIR=/data/uploads \
    KINDLEMASTER_ARTIFACT_ROOT=/data/output/artifacts \
    KINDLEMASTER_DURABLE_RUNTIME=1 \
    KINDLEMASTER_DURABLE_DB_PATH=/data/kindlemaster/runtime.sqlite3

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        ghostscript \
        openjdk-17-jre-headless \
        ocrmypdf \
        poppler-utils \
        qpdf \
        tesseract-ocr \
        tesseract-ocr-eng \
        tesseract-ocr-pol \
        unzip \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/epubcheck \
    && curl -fsSL "https://github.com/w3c/epubcheck/releases/download/v${EPUBCHECK_VERSION}/epubcheck-${EPUBCHECK_VERSION}.zip" -o /tmp/epubcheck.zip \
    && unzip -q /tmp/epubcheck.zip -d /tmp/epubcheck \
    && cp "/tmp/epubcheck/epubcheck-${EPUBCHECK_VERSION}/epubcheck.jar" /opt/epubcheck/epubcheck.jar \
    && cp -R "/tmp/epubcheck/epubcheck-${EPUBCHECK_VERSION}/lib" /opt/epubcheck/lib \
    && rm -rf /tmp/epubcheck /tmp/epubcheck.zip

WORKDIR /app

COPY requirements.txt ./
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements.txt

COPY . .
COPY --from=ui-builder /ui/static/react ./static/react

RUN mkdir -p /data/kindlemaster /data/uploads /data/output/artifacts /data/reports /data/logs

EXPOSE 5001

CMD ["python", "production_server.py"]
