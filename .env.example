# KindleMaster local observability and integration example.
# Copy to .env.local and fill values locally. Do not commit real secrets.

# ---------------------------------------------------------------------------
# Sentry observability
# ---------------------------------------------------------------------------
# Required to enable Sentry event capture.
SENTRY_DSN=https://PUBLIC_KEY@oORG_ID.ingest.sentry.io/PROJECT_ID

# Recommended tags shown on Sentry events.
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=kindlemaster-local

# Optional performance traces. Keep low locally.
SENTRY_TRACES_SAMPLE_RATE=0.0

# ---------------------------------------------------------------------------
# Optional Supabase account history/login and cloud library
# ---------------------------------------------------------------------------
# These names match the Python runtime contract in supabase_auth.py and
# supabase_library.py. Only SUPABASE_PUBLISHABLE_KEY is browser-safe; the
# service role key is backend-only and must never be exposed to Vercel/client JS.
KINDLEMASTER_AUTH_PROVIDER=supabase
KINDLEMASTER_REQUIRE_LOGIN=0
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_BACKEND_SECRET
SUPABASE_ARTIFACT_BUCKET=kindlemaster-artifacts

# ---------------------------------------------------------------------------
# Conversion job ownership and read-only artifact links
# ---------------------------------------------------------------------------
# Required for stable HMAC-signed EPUB/PDF/report links across backend restarts.
# Use a long random backend-only value and a different secret per environment.
KINDLEMASTER_JOB_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_BACKEND_SECRET
KINDLEMASTER_JOB_ACCESS_TTL_SECONDS=900
# Public hosts must not enable the ownerless local compatibility mode.
KINDLEMASTER_ALLOW_LEGACY_LOCAL_GUEST=0

# ---------------------------------------------------------------------------
# Optional Send to Kindle SMTP delivery
# ---------------------------------------------------------------------------
# Non-secret SMTP profile fields can live in user_profiles.smtp_defaults.
# Keep the SMTP password/API key in env only.
KINDLEMASTER_EMAIL_DELIVERY=0
KINDLEMASTER_SMTP_HOST=smtp.example.com
KINDLEMASTER_SMTP_PORT=587
KINDLEMASTER_SMTP_SECURITY=starttls
KINDLEMASTER_SMTP_USERNAME=sender@example.com
KINDLEMASTER_SMTP_FROM=sender@example.com
KINDLEMASTER_SMTP_PASSWORD=REPLACE_WITH_LOCAL_SECRET
KINDLEMASTER_EMAIL_MAX_ATTACHMENT_BYTES=52428800
# Also accepted for compatibility: KINDLEMASTER_SMTP_API_KEY or SMTP_PASSWORD.

# ---------------------------------------------------------------------------
# Optional R2/S3-compatible artifact storage
# ---------------------------------------------------------------------------
# Runtime uses local artifacts by default. Remote storage requires the backend
# image/environment to include boto3.
KINDLEMASTER_ARTIFACT_STORAGE=local
R2_BUCKET=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
ARTIFACT_SIGNED_URL_EXPIRES_SECONDS=900

# ---------------------------------------------------------------------------
# Optional DeepSeek audit copilot
# ---------------------------------------------------------------------------
# Evidence-only: never mutates EPUB, PGN, FEN, or TOC output.
KINDLEMASTER_DEEPSEEK_AUDIT=0
DEEPSEEK_API_KEY=REPLACE_WITH_LOCAL_SECRET
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---------------------------------------------------------------------------
# Optional OpenAI chess review copilots
# ---------------------------------------------------------------------------
# Evidence-only: AI candidates never mark FEN/PGN accepted without local validation.
OPENAI_API_KEY=REPLACE_WITH_LOCAL_SECRET
KINDLEMASTER_OPENAI_CHESS_FEN_REVIEW=0
KINDLEMASTER_OPENAI_CHESS_FEN_MODEL=gpt-5.4
KINDLEMASTER_OPENAI_CHESS_FEN_ARBITER_MODEL=gpt-5.5
KINDLEMASTER_OPENAI_PGN_REPAIR=0
KINDLEMASTER_OPENAI_PGN_MODEL=gpt-5.4
KINDLEMASTER_OPENAI_PGN_ARBITER_MODEL=gpt-5.5

# ---------------------------------------------------------------------------
# Optional split deployment: Vercel frontend -> Railway backend
# ---------------------------------------------------------------------------
# Frontend/Vercel:
VITE_KINDLEMASTER_API_BASE_URL=https://your-kindlemaster-api.up.railway.app

# Backend/Railway:
KINDLEMASTER_BIND_HOST=0.0.0.0
KINDLEMASTER_PUBLIC_BASE_URL=https://your-kindlemaster-api.up.railway.app
KINDLEMASTER_ALLOWED_ORIGINS=https://your-kindlemaster.vercel.app
KINDLEMASTER_ALLOW_LOCAL_DEV_CORS=0
KINDLEMASTER_UPLOAD_DIR=/data/uploads
KINDLEMASTER_ARTIFACT_ROOT=/data/output/artifacts
