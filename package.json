{
  "name": "kindlemaster-ui-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:ui": "vite --host 127.0.0.1 --port 5173",
    "build:ui": "vite build",
    "build:ui:vercel": "vite build --mode vercel",
    "preview:ui": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run --config vitest.config.js --dir frontend/src",
    "test:js": "vitest run --config vitest.config.js",
    "test:contract": "vitest run --config vitest.config.js --dir static/js",
    "test:ui": "vitest run --config vitest.config.js --dir frontend/src",
    "test:contracts:regression": "npm run test:contract && npm run test:ui",
    "test:coverage": "vitest run --coverage --config vitest.config.js",
    "test:e2e": "python kindlemaster.py test --suite runtime",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "trigger:dev": "npx trigger.dev@latest dev",
    "trigger:deploy": "npx trigger.dev@latest deploy",
    "trigger:check": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "@trigger.dev/sdk": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.6",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  }
}
