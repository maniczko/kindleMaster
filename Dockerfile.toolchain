FROM mcr.microsoft.com/playwright/python:v1.52.0-jammy

ARG EPUBCHECK_VERSION=5.3.0

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    KINDLEMASTER_EPUBCHECK_JAR=/opt/epubcheck/epubcheck.jar

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        ghostscript \
        openjdk-17-jre-headless \
        ocrmypdf \
        poppler-utils \
        qpdf \
        tesseract-ocr \
        tesseract-ocr-eng \
        tesseract-ocr-pol \
        unzip \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/epubcheck \
    && curl -fsSL "https://github.com/w3c/epubcheck/releases/download/v${EPUBCHECK_VERSION}/epubcheck-${EPUBCHECK_VERSION}.zip" -o /tmp/epubcheck.zip \
    && unzip -q /tmp/epubcheck.zip -d /tmp/epubcheck \
    && cp "/tmp/epubcheck/epubcheck-${EPUBCHECK_VERSION}/epubcheck.jar" /opt/epubcheck/epubcheck.jar \
    && cp -R "/tmp/epubcheck/epubcheck-${EPUBCHECK_VERSION}/lib" /opt/epubcheck/lib \
    && rm -rf /tmp/epubcheck /tmp/epubcheck.zip

WORKDIR /workspace

COPY requirements.txt requirements-dev.txt ./
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements-dev.txt

EXPOSE 5001

CMD ["python", "kindlemaster.py", "doctor"]
