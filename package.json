{
  "name": "kindlemaster-ui-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:ui": "vite --host 127.0.0.1 --port 5173",
    "build:ui": "vite build",
    "preview:ui": "vite preview --host 127.0.0.1 --port 4173",
    "test:js": "vitest run --config vitest.config.js",
    "test:contract": "vitest run --config vitest.config.js --dir static/js",
    "test:ui": "vitest run --config vitest.config.js --dir frontend/src",
    "test:contracts:regression": "npm run test:contract && npm run test:ui",
    "test:e2e": "python kindlemaster.py test --suite runtime"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.5.0"
  }
}
