# KindleMaster local observability example.
# Copy to .env.local and fill values locally. Do not commit real secrets.

# Required to enable Sentry event capture.
SENTRY_DSN=https://PUBLIC_KEY@oORG_ID.ingest.sentry.io/PROJECT_ID

# Recommended tags shown on Sentry events.
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=kindlemaster-local

# Optional performance traces. Keep low locally.
SENTRY_TRACES_SAMPLE_RATE=0.0

# Optional Supabase account history/login.
# Only publishable browser-safe keys belong here. Never add a service_role or sb_secret key.
KINDLEMASTER_SUPABASE_AUTH=1
KINDLEMASTER_SUPABASE_URL=https://PROJECT_REF.supabase.co
KINDLEMASTER_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional Send to Kindle SMTP delivery.
# Non-secret SMTP profile fields can live in user_profiles.smtp_defaults.
# Keep the SMTP password/API key in env only.
KINDLEMASTER_SMTP_PASSWORD=REPLACE_WITH_LOCAL_SECRET
# Also accepted for compatibility: KINDLEMASTER_SMTP_API_KEY or SMTP_PASSWORD.

# Optional split deployment: Vercel frontend -> Railway backend.
# Frontend/Vercel:
VITE_KINDLEMASTER_API_BASE_URL=https://your-kindlemaster-api.up.railway.app

# Backend/Railway:
KINDLEMASTER_BIND_HOST=0.0.0.0
KINDLEMASTER_PUBLIC_BASE_URL=https://your-kindlemaster-api.up.railway.app
KINDLEMASTER_ALLOWED_ORIGINS=https://your-kindlemaster.vercel.app
KINDLEMASTER_ALLOW_LOCAL_DEV_CORS=0
KINDLEMASTER_UPLOAD_DIR=/data/uploads
KINDLEMASTER_ARTIFACT_ROOT=/data/output/artifacts
