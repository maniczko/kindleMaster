{
  "version": 1,
  "description": "Golden EPUB feature expectations for representative KindleMaster publication classes. These assertions compare structural features and quality signals, not byte-identical EPUB archives.",
  "cases": [
    {
      "id": "dense_business_guide_pdf",
      "document_class": "dense_business_guide",
      "input_type": "pdf",
      "required": false,
      "requires_real_fixture": true,
      "minimum_artifact_size_bytes": 250000,
      "artifact_candidates": ["dense_business_guide_pdf.epub"],
      "expectations": {
        "language": "en",
        "min_xhtml_count": 10,
        "min_nav_entries": 50,
        "min_image_count": 20,
        "max_artifact_rate_per_1000_words": 1.0,
        "max_table_columns": 19,
        "metadata_no_placeholders": true
      }
    },
    {
      "id": "document_like_report_pdf",
      "document_class": "technical_study",
      "input_type": "pdf",
      "artifact_candidates": ["document_like_report_pdf.epub"],
      "expectations": {
        "language": "en",
        "min_xhtml_count": 3,
        "min_nav_entries": 5,
        "max_artifact_rate_per_1000_words": 1.0,
        "max_table_columns": 12,
        "metadata_no_placeholders": true
      }
    },
    {
      "id": "allegro_finance_report_pdf",
      "document_class": "finance_report",
      "input_type": "pdf",
      "language": "pl",
      "required": false,
      "notes": "Local-only real finance/report case. Put generated EPUBs under KINDLEMASTER_GOLDEN_ROOT; do not commit the source PDF or result EPUB.",
      "artifact_candidates": [
        "allegro_finance_report_pdf.epub",
        "allegro_finance_report_pdf/final.epub"
      ],
      "before_artifact_candidates": [
        "baseline/allegro_finance_report_pdf.epub",
        "allegro_finance_report_pdf/before.epub"
      ],
      "expectations": {
        "language": "pl",
        "allowed_validation_statuses": ["passed", "passed_with_warnings", "unavailable"],
        "min_xhtml_count": 1,
        "min_nav_entries": 1,
        "max_artifact_rate_per_1000_words": 5.0,
        "max_table_columns": 20,
        "metadata_no_placeholders": true
      }
    },
    {
      "id": "economist_issue_pdf",
      "document_class": "magazine_issue",
      "input_type": "pdf",
      "language": "en",
      "required": false,
      "notes": "Local-only real magazine issue case. Store artifacts under KINDLEMASTER_GOLDEN_ROOT; expectations catch noisy page-number TOC and weak magazine structure.",
      "artifact_candidates": [
        "economist_issue_pdf.epub",
        "economist_issue_pdf/final.epub"
      ],
      "before_artifact_candidates": [
        "baseline/economist_issue_pdf.epub",
        "economist_issue_pdf/before.epub"
      ],
      "expectations": {
        "language": "en",
        "allowed_validation_statuses": ["passed", "passed_with_warnings", "unavailable"],
        "min_xhtml_count": 10,
        "min_nav_entries": 20,
        "min_image_count": 1,
        "max_artifact_rate_per_1000_words": 2.0,
        "metadata_no_placeholders": true,
        "forbidden_toc_patterns": [
          "^\\d{1,4}$",
          "^contents$",
          "^(?:input|output|task|activity|key|external|data|process)$",
          "^object\\s+\\d+$",
          "^state\\s+\\d+$",
          "^rank\\s*="
        ]
      }
    },
    {
      "id": "ocr_stress_scan_pdf",
      "document_class": "scanned_ocr",
      "input_type": "pdf",
      "artifact_candidates": ["ocr_stress_scan_pdf.epub"],
      "expectations": {
        "language": "en",
        "min_xhtml_count": 2,
        "min_nav_entries": 3,
        "min_image_count": 1,
        "max_artifact_rate_per_1000_words": 4.0,
        "metadata_no_placeholders": true
      }
    },
    {
      "id": "magazine_layout_pdf",
      "document_class": "magazine_multicolumn",
      "input_type": "pdf",
      "required": false,
      "requires_real_fixture": true,
      "minimum_artifact_size_bytes": 250000,
      "artifact_candidates": ["magazine_layout_pdf.epub"],
      "expectations": {
        "language": "pl",
        "min_xhtml_count": 20,
        "min_nav_entries": 20,
        "min_image_count": 10,
        "max_artifact_rate_per_1000_words": 1.0,
        "metadata_no_placeholders": true
      }
    },
    {
      "id": "diagram_training_book_pdf",
      "document_class": "diagram_training_book",
      "input_type": "pdf",
      "required": false,
      "requires_real_fixture": true,
      "minimum_artifact_size_bytes": 250000,
